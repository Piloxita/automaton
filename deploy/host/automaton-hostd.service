[Unit]
Description=Automaton host helper (container status + start/stop requests for the Hub)

[Service]
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/Projects/automaton/deploy/host/automaton-hostd.py
Restart=on-failure
RestartSec=5
# Containers it starts keep their conmon in this cgroup: restarting the helper must not kill them.
KillMode=process

[Install]
WantedBy=default.target
