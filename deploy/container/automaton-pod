#!/usr/bin/env bash
# Creator-side control for the contained automaton (rootless podman).
#   automaton-pod build     build the image from this checkout
#   automaton-pod setup     interactive first-run wizard (wallet, name, genesis prompt)
#   automaton-pod start     run detached (restarts on exit)
#   automaton-pod stop | logs | status | shell | wallet
# State lives in two named volumes: automaton-app (its code, which it edits)
# and automaton-home (/root/.automaton: wallet, config, db).
set -euo pipefail
IMAGE=localhost/automaton:latest
NAME=automaton
REPO="$(cd "$(dirname "$0")/../.." && pwd)"
# Own network namespace: internet works, the host's localhost and port
# forwards do not. Hard resource limits; no extra privileges.
RUN_OPTS=(
  --network "pasta:--no-map-gw,-T,none,-U,none"
  --memory 3g --cpus 2 --pids-limit 1024
  --cap-drop ALL --cap-add CHOWN,DAC_OVERRIDE,FOWNER,SETUID,SETGID,KILL
  --security-opt no-new-privileges
  -v automaton-app:/app
  -v automaton-home:/root/.automaton
)

case "${1:-}" in
  build) podman build -t "$IMAGE" -f "$REPO/deploy/container/Containerfile" "$REPO" ;;
  setup) podman run --rm -it "${RUN_OPTS[@]}" "$IMAGE" node dist/index.js --setup ;;
  start) podman run -d --name "$NAME" --restart unless-stopped "${RUN_OPTS[@]}" "$IMAGE" ;;
  stop)  podman stop "$NAME" && podman rm "$NAME" ;;
  logs)  podman logs --tail "${2:-100}" -f "$NAME" ;;
  status) podman ps -a --filter name="$NAME"; podman exec "$NAME" node dist/index.js --status 2>/dev/null || true ;;
  shell) podman exec -it "$NAME" bash ;;
  wallet) podman run --rm "${RUN_OPTS[@]}" "$IMAGE" node dist/index.js --status | grep -iE "address|wallet|credits|usdc" || echo "no wallet yet: run setup" ;;
  *) sed -n '2,9p' "$0"; exit 1 ;;
esac
